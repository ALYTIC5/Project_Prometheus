# Copy to .env and fill in. Values are intentionally blank — there are no
# defaults for risk limits anywhere in the code, and there will not be:
# `import prometheus.core.config` raises at import time if any of the six
# risk variables below is missing. A silently-defaulted risk limit is worse
# than a crash (Law 4).
#
# Do not copy the values used in tests/conftest.py — those are arbitrary
# sentinels chosen to be obvious in a diff, not deployment guidance.

# --- Risk limits (Law 4: read once at startup, frozen, env-only) ---------
# All five numeric limits must be > 0.

# Max share of the portfolio in a single position, in percent.
MAX_POSITION_PCT=

# Max sum of absolute position values, in percent of portfolio.
MAX_GROSS_EXPOSURE_PCT=

# Max gross exposure divided by equity, as a multiplier (1 = unlevered).
MAX_LEVERAGE=

# Daily loss that halts trading for the session, in percent of portfolio.
MAX_DAILY_LOSS_PCT=

# Peak-to-trough drawdown that halts trading, in percent of portfolio.
MAX_DRAWDOWN_PCT=

# Master stop. true = no new positions, regardless of every limit above.
KILL_SWITCH=

# --- Database ------------------------------------------------------------
# Postgres + TimescaleDB, single instance, single database.
# postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# --- Job queue (prometheus.experiments.queue) -----------------------------
# Required only by code paths that call get_queue_settings() -- claiming,
# heartbeating, or reaping a job. No defaults, same reasoning as the risk
# limits above. JOB_HEARTBEAT_TIMEOUT_SECONDS must exceed
# JOB_HEARTBEAT_INTERVAL_SECONDS or QueueSettings raises at construction.

# How often an in-flight job refreshes jobs.heartbeat_at, in seconds.
JOB_HEARTBEAT_INTERVAL_SECONDS=

# How long since the last heartbeat before a claim is considered
# abandoned and reaped back to pending, in seconds.
JOB_HEARTBEAT_TIMEOUT_SECONDS=

# Exponential backoff base for a retried job's next run_at, in seconds.
JOB_BACKOFF_BASE_SECONDS=

# Backoff ceiling -- run_at never delays past base * 2^(attempts-1)
# capped at this value, in seconds.
JOB_BACKOFF_MAX_SECONDS=

# --- Holdout (Law 3, prometheus.validation.holdout) -----------------------
# Migration 0010 creates a genuinely separate, non-superuser Postgres role
# scoped to SELECT-only on the `holdout` schema -- see that migration's
# docstring for why this matters (Railway's own app DB user is a
# superuser and bypasses ordinary GRANT/REVOKE). Required on every
# environment that runs `alembic upgrade head` past 0010: production
# (both Railway services), CI's db-tests and laws jobs, and local dev.
# Set HOLDOUT_DB_ROLE/HOLDOUT_DB_PASSWORD and HOLDOUT_DATABASE_URL to the
# SAME role -- the first two are what the migration uses to create it,
# the third is the connection string the app actually reads it back
# through (prometheus.core.db.get_holdout_engine). They must agree by
# construction; nothing enforces that automatically.

# Role name the migration creates and grants SELECT on holdout.* to.
HOLDOUT_DB_ROLE=

# That role's login password (also embedded in HOLDOUT_DATABASE_URL below).
HOLDOUT_DB_PASSWORD=

# Full connection string, same host/port/db as DATABASE_URL, different
# user/password: postgresql+asyncpg://HOLDOUT_DB_ROLE:HOLDOUT_DB_PASSWORD@host:5432/dbname
HOLDOUT_DATABASE_URL=
