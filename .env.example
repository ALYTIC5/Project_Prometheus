# Copy to .env and fill in. Values are intentionally blank — there are no
# defaults for risk limits anywhere in the code, and there will not be:
# `import prometheus.core.config` raises at import time if any of the six
# risk variables below is missing. A silently-defaulted risk limit is worse
# than a crash (Law 4).
#
# Do not copy the values used in tests/conftest.py — those are arbitrary
# sentinels chosen to be obvious in a diff, not deployment guidance.

# --- Risk limits (Law 4: read once at startup, frozen, env-only) ---------
# All five numeric limits must be > 0.

# Max share of the portfolio in a single position, in percent.
MAX_POSITION_PCT=

# Max sum of absolute position values, in percent of portfolio.
MAX_GROSS_EXPOSURE_PCT=

# Max gross exposure divided by equity, as a multiplier (1 = unlevered).
MAX_LEVERAGE=

# Daily loss that halts trading for the session, in percent of portfolio.
MAX_DAILY_LOSS_PCT=

# Peak-to-trough drawdown that halts trading, in percent of portfolio.
MAX_DRAWDOWN_PCT=

# Master stop. true = no new positions, regardless of every limit above.
KILL_SWITCH=

# --- Database ------------------------------------------------------------
# Postgres + TimescaleDB, single instance, single database.
# postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=
