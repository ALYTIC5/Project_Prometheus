{
  "permissions": {
    "deny": [
      "Edit(/config/protected.yaml)",
      "Edit(/config/holdout.yaml)",
      "Edit(config/protected.yaml)",
      "Edit(config/holdout.yaml)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(**/.env)",
      "Read(/exports/holdout/**)",
      "Read(/exports/vault/**)"
    ],
    "ask": [
      "Edit(/config/gates.yaml)",
      "Edit(/config/search.yaml)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/.gitleaks.toml)",
      "Edit(/tests/laws/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/**)",
      "Edit(/tools/ci/check_protected_paths.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" --post",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
